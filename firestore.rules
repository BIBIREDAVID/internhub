rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return userDoc(request.auth.uid).data.role;
    }

    function isActiveSelf() {
      return userDoc(request.auth.uid).data.active != false;
    }

    function isHR() {
      return isSignedIn() && role() == "hr" && isActiveSelf();
    }

    function isManager() {
      return isSignedIn() && role() == "manager" && isActiveSelf();
    }

    function isIntern() {
      return isSignedIn() && role() == "intern" && isActiveSelf();
    }

    function managesIntern(internId) {
      return isManager() && userDoc(internId).data.managerId == request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function inviteDoc() {
      return get(/databases/$(database)/documents/invites/$(myEmail()));
    }

    function hasMatchingInvite() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/invites/$(myEmail())) &&
        inviteDoc().data.role == request.resource.data.role &&
        request.resource.data.email.lower() == myEmail() &&
        inviteDoc().data.expiresAt > request.time;
    }

    function isActiveManager(managerId) {
      return managerId == null ||
        (exists(/databases/$(database)/documents/users/$(managerId)) &&
          userDoc(managerId).data.role == "manager" &&
          userDoc(managerId).data.active != false);
    }

    // ---- users ----
    // Each doc: { role: "hr"|"manager"|"intern", managerId?, name, email, department?,
    // active?, onboardingChecklist?, onboardingStep? }. `active` defaults to true when
    // absent — HR deactivates a user instead of hard-deleting so historical
    // tasks/attendance/activityLog entries keep resolving to a real doc.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isHR() ||
        managesIntern(userId)
      );

      // HR provisions/edits any user directly (and is the only one who can
      // deactivate one, or change role/managerId). A brand-new signup may
      // create *their own* doc, but only if HR left a matching invite for
      // their email — see /invites below. Anyone may edit their own name/
      // department; interns may also edit their own onboarding progress.
      // Nobody may reactivate or change their own role/manager assignment.
      allow create: if isHR() || (isSignedIn() && request.auth.uid == userId && hasMatchingInvite());
      allow delete: if isHR();

      allow update: if (isHR() && isActiveManager(request.resource.data.managerId)) || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.managerId == resource.data.managerId &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "department", "onboardingChecklist", "onboardingStep"])
      );
    }

    // ---- invites ----
    // Doc id: lowercased email. Fields: { email, name, role, managerId?, invitedBy, invitedAt }
    // HR creates one per new hire; the signup page consumes it to self-provision
    // a users/{uid} doc with the invited role, then deletes the invite.
    match /invites/{email} {
      allow read: if isHR() || (isSignedIn() && myEmail() == email);
      allow create, update: if isHR();
      allow delete: if isHR() || (isSignedIn() && myEmail() == email);
    }

    // ---- tasks ----
    // Each doc: { title, description, dueDate, priority, status, internId, managerId, createdAt, updatedAt }
    match /tasks/{taskId} {
      allow read: if isHR() ||
        (isManager() && resource.data.managerId == request.auth.uid) ||
        (isIntern() && resource.data.internId == request.auth.uid);

      allow create: if isHR() ||
        (isManager() &&
          request.resource.data.managerId == request.auth.uid &&
          managesIntern(request.resource.data.internId));

      allow update: if isHR() ||
        (isManager() && resource.data.managerId == request.auth.uid) ||
        (isIntern() && resource.data.internId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]));

      allow delete: if isHR() || (isManager() && resource.data.managerId == request.auth.uid);

      // ---- tasks/{taskId}/comments ----
      // Doc: { authorId, authorName, authorRole, text, createdAt }. Anyone who
      // can read the parent task can comment on it; comments are immutable
      // once posted (no update/delete) to keep the thread an honest record.
      match /comments/{commentId} {
        function canAccessTask() {
          return isHR() ||
            (isManager() && get(/databases/$(database)/documents/tasks/$(taskId)).data.managerId == request.auth.uid) ||
            (isIntern() && get(/databases/$(database)/documents/tasks/$(taskId)).data.internId == request.auth.uid);
        }

        allow read: if canAccessTask();
        allow create: if canAccessTask() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- attendance ----
    // Doc id: {internId}_{yyyy-mm-dd}. Fields: internId, date, status, checkIn, checkOut, note, managerComment
    match /attendance/{recordId} {
      allow read: if isHR() ||
        (isIntern() && resource.data.internId == request.auth.uid) ||
        managesIntern(resource.data.internId);

      allow create: if isHR() ||
        (isIntern() &&
          request.resource.data.internId == request.auth.uid &&
          recordId == request.auth.uid + "_" + request.resource.data.date);

      allow update: if isHR() ||
        (isIntern() &&
          resource.data.internId == request.auth.uid &&
          request.resource.data.internId == resource.data.internId &&
          request.resource.data.date == resource.data.date) ||
        (managesIntern(resource.data.internId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "managerComment", "managerCommentUpdatedAt", "reviewedByManagerAt"]));

      allow delete: if isHR();
    }

    // ---- applications ----
    // HR-managed recruitment pipeline. No public write path from this app.
    match /applications/{applicationId} {
      allow read, write: if isHR();
    }

    // ---- activityLog ----
    // Append-only audit trail of HR actions. Doc: { action, actorId, actorEmail,
    // targetType, targetId, details, createdAt }. Never updated or deleted.
    match /activityLog/{entryId} {
      allow read, create: if isHR();
      allow update, delete: if false;
    }
  }
}
